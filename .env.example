# Public site URL used for metadata, sitemap, and robots.
NEXT_PUBLIC_SITE_URL=https://grace-dental.vercel.app

# Resend API key for form emails (server only — never expose with NEXT_PUBLIC_).
RESEND_API_KEY=

# Verified sender for outgoing form emails. Must be a sender/domain verified
# in Resend (e.g. "Grace Dental <hello@your-verified-domain.com>").
EMAIL_FROM=

# Inbox that receives contact + appointment requests. Defaults to
# gracedentalsantarosa@gmail.com when unset.
CONTACT_TO_EMAIL=
